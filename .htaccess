# ============================================================
#  Cornerstone Digital — Performance Headers
# ============================================================

# --- Custom 404 Error Document ---
ErrorDocument 404 /404.html

# --- Charset Encoding ---
AddDefaultCharset UTF-8

# --- Protect Internal Publishing & Blueprint Data ---
<FilesMatch "^(publishing-state\.json|publishing-schedule\.json|cms-content\.json|schema-blueprints\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# --- URL Rewriting & Clean URLs ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force Non-WWW
  RewriteCond %{HTTP_HOST} ^www\.cornerstonedg\.com [NC]
  RewriteRule ^(.*)$ https://cornerstonedg.com/$1 [L,R=301]

  # Redirect /blog to /blogs
  RewriteRule ^blog/?$ /blogs [R=301,L]

  # Legacy Template Blog Post 301 Redirects to Overhauled Articles
  RewriteRule ^blog/minimalist-branding-for-modern-tech-startups(\.html)?/?$ /blog/small-business-website-cost-uk/ [R=301,L]
  RewriteRule ^blog/maximizing-conversion-with-strategic-web-design(\.html)?/?$ /blog/ai-receptionist-vs-missed-call-text-back/ [R=301,L]
  RewriteRule ^blog/impact-of-typography-on-global-brand-recall(\.html)?/?$ /blog/local-seo-ai-search-small-business/ [R=301,L]
  RewriteRule ^blog/scaling-saas-products-with-high-performance-code(\.html)?/?$ /blog/small-business-automations/ [R=301,L]
  RewriteRule ^blog/why-motion-design-enhances-user-retention(\.html)?/?$ /blog/core-web-vitals-small-business/ [R=301,L]
  RewriteRule ^blog/creating-emotional-connections-through-digital-storytelling(\.html)?/?$ /blog/ask-for-google-reviews/ [R=301,L]
  RewriteRule ^blog/designing-for-accessibility-in-luxury-interfaces(\.html)?/?$ /blog/website-accessibility-checklist-small-business/ [R=301,L]
  RewriteRule ^blog/mastering-seo-strategy-for-creative-agencies(\.html)?/?$ /blog/website-builder-vs-web-designer/ [R=301,L]
  RewriteRule ^blog/why-your-website-isnt-generating-enquiries(\.html)?/?$ /blog/website-not-generating-enquiries/ [R=301,L]

  # Serve existing directory index or file
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve .html file if requested without extension
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# --- Enable Gzip Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE font/opentype
</IfModule>

# --- Browser Caching ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Images — 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"

  # Video — 1 year
  ExpiresByType video/mp4 "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"

  # CSS & JS — 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # HTML — 1 hour (so updates propagate quickly)
  ExpiresByType text/html "access plus 1 hour"

  # JSON — 1 day
  ExpiresByType application/json "access plus 1 day"

  # Default
  ExpiresDefault "access plus 1 week"
</IfModule>

# --- Cache-Control Headers ---
<IfModule mod_headers.c>
  # Images & video: immutable for 1 year
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|avif|ico|mp4|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS & JS: 1 month
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML: short cache, must revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Sitemap & robots: always fresh
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set Content-Type "application/xml; charset=UTF-8"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- WebP MIME Type ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# --- ETags ---
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# --- Keep-Alive ---
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>
